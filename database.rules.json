{
  "rules": {
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
        "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" },
        "x": { ".validate": "newData.isNumber()" },
        "z": { ".validate": "newData.isNumber()" },
        "rotY": { ".validate": "newData.isNumber()" },
        "room": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
